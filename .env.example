# Copy this file to .env and fill in every required value.
PORT=3000

# Generate a unique secret, for example with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Used only to create the initial manager if no manager account exists yet.
INITIAL_MANAGER_USERNAME=
INITIAL_MANAGER_PASSWORD=

# Comma-separated exact browser origins allowed to call the API / Socket.IO.
# Keep the local defaults if the app is served from this same local origin.
# Example: CORS_ORIGINS=https://example.com,https://www.example.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
